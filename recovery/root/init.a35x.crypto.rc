# Services are started by the recovery decrypt preparation hook.
service a35x-tzdaemon /vendor/bin/tzdaemon
    user root
    group root system radio
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/lib64/a35x-vndk33:/vendor/lib64

service a35x-tzts /vendor/bin/tzts_daemon
    user root
    group root system
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/lib64/a35x-vndk33:/vendor/lib64

service a35x-keymint /vendor/bin/hw/android.hardware.security.keymint-service
    user root
    group root system keystore
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/lib64/a35x-vndk33:/vendor/lib64

service a35x-gatekeeper /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    user root
    group root system
    disabled
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/lib64/a35x-vndk33:/vendor/lib64
