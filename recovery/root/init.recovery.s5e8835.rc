import /init.a35x.crypto.rc

on init
    write /proc/sys/kernel/hung_task_timeout_secs 0

    start watchdogd
    start health-hal-2-1
    
# Unlink /efs > /mnt/vendor/efs
    rm /efs
    mkdir /efs
    mkdir /sec_efs
    
# Use Samsung normal charging policy; retain driver thermal and PD limits.
# (siop_level 0 limits charging to 100mA.)
    write /sys/class/power_supply/battery/siop_level 100

on late-init
    setprop sys.usb.controller 13200000.dwc3
    setprop ro.debuggable 1
    setprop service.adb.root 1
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb
    
on fs
    wait /dev/block/platform/${ro.boot.boot_devices}
    symlink /dev/block/platform/${ro.boot.boot_devices} /dev/block/bootdevice
    symlink /dev/block/platform/${ro.boot.boot_devices}/by-name /dev/block/by-name

    symlink /dev/block/platform/${ro.boot.boot_devices}/by-name/param /dev/block/param
    chown root system /dev/block/param
    chmod 0666 /dev/block/param

    export ANDROID_ROOT /system_root

# Set watchdog timer to 30 seconds and fed it every 10 seconds to get a 20 second margin
service watchdogd /system/bin/watchdogd 10 20
    class core
    oneshot
    seclabel u:r:watchdogd:s0

# Samsung's bootloader saves REBOOT_MODE=4 (recovery) in PARAM, and recovery's
# Power off does not reset it, so the next cold power-on returns to recovery.
# Consume that saved selection once recovery starts; this only affects the next
# ordinary power-on. Source: tools/a35-normal-boot/a35-normal-boot.c
on fs
    exec u:r:recovery:s0 root root -- /system/bin/a35-normal-boot
