+// Let the device release /vendor (eg, stop services running from it) before an
+// explicit unmount requested by the user, a script or an installer.
+void TWFunc::Prepare_Vendor_Unmount(const std::string& path)
+{
+	if (TWFunc::Get_Root_Path(path) != "/vendor" || !PartitionManager.Is_Mounted_By_Path("/vendor"))
+		return;
+	if (TWFunc::Path_Exists(FOX_PRE_VENDOR_UNMOUNT_SCRIPT))
+		TWFunc::RunFoxScript(FOX_PRE_VENDOR_UNMOUNT_SCRIPT, "");
+}
+
