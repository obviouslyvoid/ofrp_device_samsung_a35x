diff --git a/orangefox.mk b/orangefox.mk
index d1e5046..aaa9fcf 100644
--- a/orangefox.mk
+++ b/orangefox.mk
@@ -336,6 +336,18 @@ ifeq ($(OF_REDUCE_DECRYPTION_TIMEOUT),1)
     LOCAL_CFLAGS += -DOF_REDUCE_DECRYPTION_TIMEOUT='"1"'
 endif
 
+# keep /vendor mounted at startup, for devices whose recovery runs vendor services
+# (health HAL, TEE/keymint for decryption) from the real /vendor partition
+ifeq ($(OF_KEEP_VENDOR_MOUNTED),1)
+    LOCAL_CFLAGS += -DOF_KEEP_VENDOR_MOUNTED
+endif
+
+# store the recovery password backup (.fsec) on this partition instead of /persist,
+# eg "/cache"; it must be mountable before data is decrypted
+ifneq ($(OF_PASSWORD_BACKUP_PARTITION),)
+    LOCAL_CFLAGS += -DOF_PASSWORD_BACKUP_PARTITION='"$(OF_PASSWORD_BACKUP_PARTITION)"'
+endif
+
 ifeq ($(OF_DONT_KEEP_LOG_HISTORY),1)
     LOCAL_CFLAGS += -DOF_DONT_KEEP_LOG_HISTORY='"1"'
 endif
diff --git a/partitionmanager.cpp b/partitionmanager.cpp
index 00277cd..fe17efb 100755
--- a/partitionmanager.cpp
+++ b/partitionmanager.cpp
@@ -237,6 +237,14 @@ static inline std::string KM_Ver_From_Manifest(std::string ver) {
 	return ver;
 }
 
+// Keep /vendor mounted during startup when init mounted it before recovery processed
+// the fstab, or when the device runs vendor services from it (OF_KEEP_VENDOR_MOUNTED).
+#ifdef OF_KEEP_VENDOR_MOUNTED
+static bool vendor_premounted = true;
+#else
+static bool vendor_premounted = false;
+#endif
+
 void inline Process_Keymaster_Version(TWPartition *ven, bool Display_Error) {
 	// Fetch the Keymaster Service version to be started
 	std::string version;
@@ -496,6 +504,12 @@ clear:
 	TWPartition* ven = PartitionManager.Find_Partition_By_Path("/vendor");
 	TWPartition* odm = PartitionManager.Find_Partition_By_Path("/odm");
 	if (recovery_mode && !parse_userdata) {
+		// A /vendor mounted before recovery started (first-stage mount) can be in
+		// use by vendor services; leave it mounted instead of failing to unmount it.
+		if (ven && ven->Is_Mounted())
+			vendor_premounted = true;
+		if (vendor_premounted)
+			LOGINFO("Keeping /vendor mounted (in use by vendor services)\n");
 		if (ven) ven->Mount(Display_Error);
 		if (odm) odm->Mount(Display_Error);
 
@@ -524,8 +538,8 @@ clear:
 	usleep(65536);
 	if (odm) odm->UnMount(Display_Error);
 	if (recovery_mode)
-		Process_Keymaster_Version(ven, false);
-	if (ven) ven->UnMount(Display_Error);
+		Process_Keymaster_Version(vendor_premounted ? NULL : ven, false);
+	if (ven && !vendor_premounted) ven->UnMount(Display_Error);
 	return true;
 }
 
@@ -580,7 +594,7 @@ void TWPartitionManager::Setup_Fstab_Partitions(bool Display_Error) {
 			}
 		}
 	#ifndef USE_VENDOR_LIBS
-		if (ven)
+		if (ven && !vendor_premounted)
 			ven->UnMount(Display_Error);
 		if (sys)
 			sys->UnMount(Display_Error);
