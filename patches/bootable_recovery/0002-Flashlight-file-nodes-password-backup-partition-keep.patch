+static void Save_Password_Backup(void)
+{
+  ofstream file;
+  file.open(FOX_PASS_IN_PERSIST, std::ofstream::out | std::ofstream::trunc);
+  if (file.is_open()) {
+    file << "fox_use_pass="    + DataManager::GetStrValue("fox_use_pass") +
