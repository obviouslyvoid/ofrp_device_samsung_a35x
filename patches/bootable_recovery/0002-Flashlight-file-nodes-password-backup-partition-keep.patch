+    Save_Password_Backup();
+  #endif
+
   string mount_path = GetSettingsStoragePath();
   PartitionManager.Mount_By_Path(mount_path.c_str(), 1);
 
diff --git a/gui/action.cpp b/gui/action.cpp
index 293dd16..f13a486 100755
--- a/gui/action.cpp
+++ b/gui/action.cpp
@@ -2568,6 +2568,21 @@ int GUIAction::setbootslot(std::string arg)
 	return 0;
 }
 
+// A flashlight path is normally an LED class directory containing brightness and
+// max_brightness. Some devices (e.g. Samsung's /sys/class/camera/flash/rear_flash)
+// expose a single control file instead; use such a file directly, with max 1.
+static void flashlight_nodes(const std::string& path, std::string& bright, std::string& max)
+{
+	struct stat st;
+	if (stat(path.c_str(), &st) == 0 && S_ISREG(st.st_mode)) {
+		bright = path;
+		max.clear();
+	} else {
+		bright = path + "/brightness";
+		max = path + "/max_brightness";
+	}
+}
+
 int GUIAction::flashlightImpl(std::string arg __unused)
 {
     string enable_flash;
