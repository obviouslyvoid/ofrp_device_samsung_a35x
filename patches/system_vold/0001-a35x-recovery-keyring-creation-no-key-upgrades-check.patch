From 8b98d072f4f8df68a43e39aac3943c4b29e2b95b Mon Sep 17 00:00:00 2001
From: obviouslyvoid <obviouslyvoid@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:53:51 +0200
Subject: [PATCH] a35x recovery: keyring creation, no key upgrades, check
 metadata mount

- KeyUtil: create the session "fscrypt" keyring when missing; recovery
  does not run Android's post-fs-data keyring initialization.
- KeyStorage: return early when the key blob was not upgraded.
- MetadataCrypt: fail when mounting the metadata-encrypted fs fails.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ie279455290bcbcc0a1ac8b71421982a4eb754e2d
---
 KeyStorage.cpp    | 2 +-
 KeyUtil.cpp       | 4 ++++
 MetadataCrypt.cpp | 2 +-
 3 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/KeyStorage.cpp b/KeyStorage.cpp
index 51fc4f6..a6b81a3 100644
--- a/KeyStorage.cpp
+++ b/KeyStorage.cpp
@@ -370,7 +370,7 @@ static KeymasterOperation BeginKeymasterOp(Keymaster& keymaster, const std::stri
     if (!opHandle) return opHandle;
 
     // If key blob wasn't upgraded, nothing left to do.
-    // if (!opHandle.getUpgradedBlob()) return opHandle;
+    if (!opHandle.getUpgradedBlob()) return opHandle;
 
     // if (already_upgraded) {
     //     LOG(ERROR) << "Unexpected case; already-upgraded key " << upgraded_blob_file
diff --git a/KeyUtil.cpp b/KeyUtil.cpp
index 9273564..2e9310e 100644
--- a/KeyUtil.cpp
+++ b/KeyUtil.cpp
@@ -148,6 +148,10 @@ static std::string buildLegacyKeyName(const std::string& prefix, const std::stri
 // old to support FS_IOC_ADD_ENCRYPTION_KEY and FS_IOC_REMOVE_ENCRYPTION_KEY.
 static bool fscryptKeyring(key_serial_t* device_keyring) {
     *device_keyring = keyctl_search(KEY_SPEC_SESSION_KEYRING, "keyring", "fscrypt", 0);
+    // Recovery does not run Android's post-fs-data keyring initialization.
+    if (*device_keyring == -1 && errno == ENOKEY) {
+        *device_keyring = add_key("keyring", "fscrypt", nullptr, 0, KEY_SPEC_SESSION_KEYRING);
+    }
     if (*device_keyring == -1) {
         PLOG(ERROR) << "Unable to find device keyring";
         return false;
diff --git a/MetadataCrypt.cpp b/MetadataCrypt.cpp
index dd6d880..c1ad69a 100644
--- a/MetadataCrypt.cpp
+++ b/MetadataCrypt.cpp
@@ -305,7 +305,7 @@ bool fscrypt_mount_metadata_encrypted(const std::string& blk_device, const std::
     }
 
     LOG(INFO) << "Mounting metadata-encrypted filesystem:" << mount_point;
-    mount_via_fs_mgr(mount_point.c_str(), crypto_blkdev.c_str());
+    if (!mount_via_fs_mgr(mount_point.c_str(), crypto_blkdev.c_str())) return false;
     android::base::SetProperty("ro.crypto.fs_crypto_blkdev", crypto_blkdev);
 
     // Record that there's at least one fstab entry with metadata encryption
