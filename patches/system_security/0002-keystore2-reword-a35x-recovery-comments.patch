From 71974cc884edc9fd6f0de769865bd64acbb6e0a5 Mon Sep 17 00:00:00 2001
From: obviouslyvoid <obviouslyvoid@users.noreply.github.com>
Date: Tue, 10 Nov 2026 20:37:00 +0200
Subject: [PATCH 2/2] keystore2: reword a35x recovery comments

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I5998c652f230c98cac672607abaed09d4db1c953
---
 keystore2/src/raw_device.rs     | 2 +-
 keystore2/src/security_level.rs | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/keystore2/src/raw_device.rs b/keystore2/src/raw_device.rs
index bccd2b6..83819b6 100644
--- a/keystore2/src/raw_device.rs
+++ b/keystore2/src/raw_device.rs
@@ -260,7 +260,7 @@ impl KeyMintDevice {
     {
         match f(&key_blob) {
             Err(Error::Km(ErrorCode::KEY_REQUIRES_UPGRADE)) => {
-                // Private recovery probe: do not upgrade existing Android keys.
+                // a35x recovery: do not upgrade existing Android keys.
                 if std::env::var_os("A35X_ALLOW_KEY_BLOB_UPGRADE").is_none() {
                     return Err(Error::Km(ErrorCode::KEY_REQUIRES_UPGRADE))
                         .context("a35x recovery: key-blob upgrades disabled");
diff --git a/keystore2/src/security_level.rs b/keystore2/src/security_level.rs
index 73b045a..dfbd1b2 100644
--- a/keystore2/src/security_level.rs
+++ b/keystore2/src/security_level.rs
@@ -835,7 +835,7 @@ impl KeystoreSecurityLevel {
     {
         match f(key_blob) {
             Err(Error::Km(ErrorCode::KEY_REQUIRES_UPGRADE)) => {
-                // Private recovery probe: do not upgrade existing Android keys.
+                // a35x recovery: do not upgrade existing Android keys.
                 if std::env::var_os("A35X_ALLOW_KEY_BLOB_UPGRADE").is_none() {
                     return Err(Error::Km(ErrorCode::KEY_REQUIRES_UPGRADE))
                         .context("a35x recovery: key-blob upgrades disabled");
