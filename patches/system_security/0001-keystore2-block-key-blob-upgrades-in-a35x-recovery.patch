From 98aa9ac951dec686e8afbec3cbe97a7ad7efc030 Mon Sep 17 00:00:00 2001
From: obviouslyvoid <obviouslyvoid@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:53:51 +0200
Subject: [PATCH 1/2] keystore2: block key-blob upgrades in a35x recovery

Return KEY_REQUIRES_UPGRADE instead of upgrading existing Android keys,
unless A35X_ALLOW_KEY_BLOB_UPGRADE is set, so recovery never rewrites
the ROM's key blobs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: If156a2497cbd980e1446e0aabcc2187a0a719b05
---
 keystore2/src/raw_device.rs     | 5 +++++
 keystore2/src/security_level.rs | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/keystore2/src/raw_device.rs b/keystore2/src/raw_device.rs
index 9409e5b..bccd2b6 100644
--- a/keystore2/src/raw_device.rs
+++ b/keystore2/src/raw_device.rs
@@ -260,6 +260,11 @@ impl KeyMintDevice {
     {
         match f(&key_blob) {
             Err(Error::Km(ErrorCode::KEY_REQUIRES_UPGRADE)) => {
+                // Private recovery probe: do not upgrade existing Android keys.
+                if std::env::var_os("A35X_ALLOW_KEY_BLOB_UPGRADE").is_none() {
+                    return Err(Error::Km(ErrorCode::KEY_REQUIRES_UPGRADE))
+                        .context("a35x recovery: key-blob upgrades disabled");
+                }
                 let upgraded_blob = map_km_error({
                     let _wp = wd::watch_millis(
                         "In KeyMintDevice::upgrade_keyblob_if_required_with: calling upgradeKey.",
